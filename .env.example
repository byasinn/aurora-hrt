# Copie para .env e preencha antes de rodar `npm run dev` (netlify dev)

# Connection string do Neon (Netlify DB). Depois de habilitar a extensão
# Netlify DB no painel do site, ela injeta NETLIFY_DATABASE_URL automaticamente
# em produção — localmente, copie o valor do painel Netlify > Site config > Environment variables.
NETLIFY_DATABASE_URL=

# Senha simples para travar o acesso ao app (v1, uso pessoal).
APP_PASSPHRASE=

# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:miguelcastro.liber@gmail.com
