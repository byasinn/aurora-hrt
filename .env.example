# Copie para .env e preencha antes de rodar `npm run dev` (netlify dev)
#
# NETLIFY_DB_URL não entra aqui — depois de habilitar a extensão Netlify DB
# no painel do site, o `netlify dev` injeta essa variável sozinho
# (local aponta pro Postgres local do dev, produção aponta pro Neon real).

# Senha simples pra travar o acesso ao app — não é mais usada pelo código
# (substituída por login real), pode deixar em branco.
APP_PASSPHRASE=

# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:miguelcastro.liber@gmail.com

# Login — lista de emails com acesso liberado (separados por vírgula, sem espaço)
ALLOWED_EMAILS=

# Login com Google — criar OAuth client em https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:8888/api/auth-google-callback e a URL de produção + /api/auth-google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Envio de email (confirmação de cadastro, reset de senha) — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=

# Moderação de imagem (bloqueia nudez/pornografia no upload) — crie uma conta grátis
# em https://sightengine.com/, pegue as credenciais no painel. Sem isso, a checagem
# fica desligada (não trava upload), mas fica avisado no log do Worker.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
